// kernel_det.cl - параллельное прямое исключение Гаусса (приведение к верхнетреугольному виду)
// Каждый work-item обрабатывает одну строку, лежащую ниже опорной, и вычитает из неё
// соответствующую долю опорной строки. Шаги k = 0..n-1 выполняются последовательно
// (запуск ядра из хоста n раз), так как каждый следующий шаг зависит от предыдущего.
__kernel void eliminate_step(__global double* a, const int n, const int k) {
    int i = get_global_id(0) + k + 1;   // номер обрабатываемой строки, лежащей ниже опорной
    if (i >= n) return;

    double pivot = a[k * n + k];
    double factor = a[i * n + k] / pivot;

    for (int j = k; j < n; j++) {
        a[i * n + j] -= factor * a[k * n + j];
    }
}
