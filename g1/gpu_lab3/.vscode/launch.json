{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lab3 demo (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Release/lab3.exe",
      "args": ["demo"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "lab3 demo (MinGW/GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/lab3.exe",
      "args": ["demo"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb"
    }
  ]
}
