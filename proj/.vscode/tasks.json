{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: CPU (det_cpu)",
      "type": "shell",
      "command": "gcc",
      "args": ["-O2", "-g", "-o", "det_cpu${exeExt}", "det_cpu.c", "-lm"],
      "options": { "cwd": "${workspaceFolder}/cpu" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: CPU (bruteforce_cpu)",
      "type": "shell",
      "command": "gcc",
      "args": ["-O2", "-g", "-o", "bruteforce_cpu${exeExt}", "bruteforce_cpu.c", "-lm"],
      "options": { "cwd": "${workspaceFolder}/cpu" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: GPU (det_host, OpenCL) - Windows/OLSDK",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-O2", "-g", "-o", "det_host.exe", "det_host.c",
        "-I", "${env:OCL_SDK}\\include",
        "-L", "${env:OCL_SDK}\\lib\\x86_64",
        "-l", "OpenCL"
      ],
      "options": { "cwd": "${workspaceFolder}/gpu" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Перед запуском задайте переменную окружения OCL_SDK (путь к папке с OpenCL SDK, например OLSDK)."
    },
    {
      "label": "Build: GPU (bf_host, OpenCL) - Windows/OLSDK",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-O2", "-g", "-o", "bf_host.exe", "bf_host.c",
        "-I", "${env:OCL_SDK}\\include",
        "-L", "${env:OCL_SDK}\\lib\\x86_64",
        "-l", "OpenCL"
      ],
      "options": { "cwd": "${workspaceFolder}/gpu" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Перед запуском задайте переменную окружения OCL_SDK (путь к папке с OpenCL SDK, например OLSDK)."
    },
    {
      "label": "Build: GPU (det_host, OpenCL) - Linux",
      "type": "shell",
      "command": "gcc",
      "args": ["-O2", "-g", "-o", "det_host", "det_host.c", "-lOpenCL"],
      "options": { "cwd": "${workspaceFolder}/gpu" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: GPU (bf_host, OpenCL) - Linux",
      "type": "shell",
      "command": "gcc",
      "args": ["-O2", "-g", "-o", "bf_host", "bf_host.c", "-lOpenCL"],
      "options": { "cwd": "${workspaceFolder}/gpu" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
